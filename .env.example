# --- Routines (Phase R1) ---------------------------------------------------
# IDs for the two routines. Filled in during Phase R1 onboarding.
# See docs/r1-deviations.md D3 for why this is 2 routines, not 3.
ROUTINE_DAILY_ID=
ROUTINE_PROCESSOR_ID=

# --- Dashboard auth --------------------------------------------------------
# Single-user HTTP basic auth password (carried over from v1).
DASHBOARD_PASSWORD=

# --- GitHub data branch (Phase R6) -----------------------------------------
# Where the dashboard reads briefings from. The data branch is force-pushed
# by the daily routine and serves as the primary store in v1-routines.
GITHUB_REPO_SLUG=emstacho-su/ai-news-agent-routines
GITHUB_DATA_BRANCH=data

# Only required if the repo is private. PAT with `contents:read`.
GITHUB_PAT=

# --- Email -----------------------------------------------------------------
# Phase R2 (Resend MCP) is deleted. The daily routine uses the Gmail
# connector (uuid 468bd9e7-cae6-4c6c-8a3b-f9db61d8d737) directly.
# Only the recipient address is needed in env, and only by the dashboard
# for deep-link rendering. The routine's prompt receives it via the
# routine's own configuration on claude.ai/code/routines.
NOTIFY_TO_EMAIL=

# --- Dashboard URL ---------------------------------------------------------
# Used in email deep links and share links. Set to the Fly app URL in prod.
DASHBOARD_BASE_URL=http://localhost:8000
