# --- Routines (Phase R1) ---------------------------------------------------
# IDs returned by `claude routines create` for each of the three routines.
# Filled in during Phase R1 onboarding.
ROUTINE_DAILY_ID=
ROUTINE_FOLLOWUP_ID=
ROUTINE_CUSTOM_ID=

# Bearer token for the Routines HTTP trigger API. Issued by Claude Code
# when you enable HTTP triggers on a routine.
ROUTINE_API_TOKEN=

# --- Dashboard auth --------------------------------------------------------
# Single-user HTTP basic auth password (carried over from v1).
DASHBOARD_PASSWORD=

# --- GitHub data branch (Phase R6) -----------------------------------------
# Where the dashboard reads briefings from. The data branch is force-pushed
# by the daily routine and serves as the primary store in v1-routines.
GITHUB_REPO_SLUG=emstacho-su/ai-news-agent-routines
GITHUB_DATA_BRANCH=data

# Only required if the repo is private. PAT with `contents:read`.
GITHUB_PAT=

# --- Resend MCP (Phase R2) -------------------------------------------------
# Used by the Resend MCP server, NOT by Python. Listed here as the source
# of truth so the secret is rotated in one place; copied to MCP server env.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
NOTIFY_FROM_EMAIL=

# --- Dashboard URL ---------------------------------------------------------
# Used in email deep links and share links. Set to the Fly app URL in prod.
DASHBOARD_BASE_URL=http://localhost:8000
